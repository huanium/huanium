Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Adiabatic", " ", "potential", " ", "curves"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"zCollisionAdiabats", "=", 
     RowBox[{
      RowBox[{"Eigenvalues", "[", 
       RowBox[{"HDD", "[", 
        RowBox[{
        "r", ",", "DD", ",", "\[Delta]MW", ",", "\[CapitalOmega]R", ",", 
         RowBox[{"\[Theta]Collision", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", 
         RowBox[{"\[Phi]Collision", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", "\[Xi]MW"}], "]"}], "]"}], "-", 
      RowBox[{"CVdW6", "/", 
       RowBox[{"r", "^", "6"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"xCollisionAdiabats", "=", 
     RowBox[{

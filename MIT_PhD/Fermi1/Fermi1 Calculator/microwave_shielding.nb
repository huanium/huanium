Cell[BoxData[
 RowBox[{
  RowBox[{"adip", "[", 
   RowBox[{
   "\[CapitalOmega]\[Sigma]_", ",", "\[CapitalOmega]\[Pi]_", ",", 
    "\[Delta]\[Sigma]_", ",", "\[Delta]\[Pi]_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "Hdouble", ",", "evals", ",", "evecs", ",", "UpUp", ",", "adip"}], "}"}],
     ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Hdouble", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", "0", ",", " ", 
           RowBox[{
            SubscriptBox["\[CapitalOmega]", "\[Pi]"], "/", "2"}], ",", 
           RowBox[{
            SubscriptBox["\[CapitalOmega]", "\[Sigma]"], "/", "2"}]}], "}"}], 
         ",", "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"0", ",", 
           RowBox[{"-", 
            SubscriptBox["\[CapitalDelta]", "\[Sigma]"]}], ",", "0", ",", 
           "0"}], "}"}], ",", "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            SubscriptBox["\[CapitalOmega]", "\[Pi]"], "/", "2"}], ",", "0", 
           ",", 
           RowBox[{"-", 
            SubscriptBox["\[CapitalDelta]", "\[Pi]"]}], ",", "0"}], "}"}], 
         ",", "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            SubscriptBox["\[CapitalOmega]", "\[Sigma]"], "/", "2"}], ",", "0",
            ",", "0", ",", 
           RowBox[{"-", 
            SubscriptBox["\[CapitalDelta]", "\[Sigma]"]}]}], "}"}]}], "}"}], "/.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          SubscriptBox["\[CapitalOmega]", "\[Sigma]"], "->", 
          "\[CapitalOmega]\[Sigma]"}], ",", 
         RowBox[{
          SubscriptBox["\[CapitalOmega]", "\[Pi]"], "->", 
          "\[CapitalOmega]\[Pi]"}], ",", 
         RowBox[{
          SubscriptBox["\[CapitalDelta]", "\[Pi]"], "->", "\[Delta]\[Pi]"}], 
         ",", 
         RowBox[{
          SubscriptBox["\[CapitalDelta]", "\[Sigma]"], "->", 
          "\[Delta]\[Sigma]"}]}], "}"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"evals", ",", "evecs"}], "}"}], "=", 
      RowBox[{"Eigensystem", "[", "Hdouble", "]"}]}], ";", "\n", 
     RowBox[{"UpUp", "=", 
      RowBox[{"evecs", "[", 
       RowBox[{"[", 
        RowBox[{
         RowBox[{"Ordering", "[", 
          RowBox[{
           RowBox[{"N", "[", "evals", "]"}], ",", 
           RowBox[{"-", "1"}]}], "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}]}], ";", 
     RowBox[{"(*", 
      RowBox[{
      "Take", " ", "eigenstate", " ", "with", " ", "the", " ", "highest", " ",
        "eigenvalue"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"UpUp", "=", 
      RowBox[{"UpUp", "/", 
       RowBox[{"Norm", "[", "UpUp", "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"adip", "=", 
      RowBox[{"17.77", "*", 
       RowBox[{"2.72", "^", "2"}], "*", 
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{"UpUp", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "]"}], "^", "2"}], " ", "*", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", " ", "*", " ", 
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{"UpUp", "[", 
              RowBox[{"[", "3", "]"}], "]"}], "]"}], "^", "2"}]}], " ", "-", 
          " ", 
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{"UpUp", "[", 
             RowBox[{"[", "4", "]"}], "]"}], "]"}], "^", "2"}]}], ")"}], "/", 
        "3"}]}]}], ";", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"44.01", " ", "magic", " ", "factor"}], ",", " ", 
       RowBox[{
        RowBox[{"5.53", " ", "for", " ", "NaCs", " ", "D"}], "=", "4.75"}]}], 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"Return", "[", "adip", "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",

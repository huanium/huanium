          RowBox[{"[", "3", "]"}], "]"}], ",", "\[Xi]MW"}], "]"}], "]"}], "-", 
      RowBox[{"CVdW6", "/", 
       RowBox[{"r", "^", "6"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"zCollisions", "=", 

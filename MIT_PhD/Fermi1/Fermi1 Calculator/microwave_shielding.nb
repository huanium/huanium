Cell[BoxData[
 RowBox[{
  RowBox[{"dEffCalc1", "[", 
   RowBox[{
   "\[CapitalOmega]\[Sigma]_", ",", "\[CapitalOmega]\[Pi]_", ",", 
    "\[Delta]\[Sigma]_", ",", "\[Delta]\[Pi]_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "Hdouble", ",", "evals", ",", "evecs", ",", "UpUp", ",", "d\[Pi]", ",", 
      "d\[Sigma]"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Hdouble", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", "0", ",", " ", 
           RowBox[{
            SubscriptBox["\[CapitalOmega]", "\[Pi]"], "/", "2"}], ",", 
           RowBox[{
            SubscriptBox["\[CapitalOmega]", "\[Sigma]"], "/", "2"}]}], "}"}], 
         ",", "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"0", ",", 
           RowBox[{"-", 
            SubscriptBox["\[CapitalDelta]", "\[Sigma]"]}], ",", "0", ",", 
           "0"}], "}"}], ",", "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            SubscriptBox["\[CapitalOmega]", "\[Pi]"], "/", "2"}], ",", "0", 
           ",", 
           RowBox[{"-", 
            SubscriptBox["\[CapitalDelta]", "\[Pi]"]}], ",", "0"}], "}"}], 
         ",", "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            SubscriptBox["\[CapitalOmega]", "\[Sigma]"], "/", "2"}], ",", "0",
            ",", "0", ",", 
           RowBox[{"-", 
            SubscriptBox["\[CapitalDelta]", "\[Sigma]"]}]}], "}"}]}], "}"}], "/.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          SubscriptBox["\[CapitalOmega]", "\[Sigma]"], "->", 
          "\[CapitalOmega]\[Sigma]"}], ",", 
         RowBox[{
          SubscriptBox["\[CapitalOmega]", "\[Pi]"], "->", 
          "\[CapitalOmega]\[Pi]"}], ",", 
         RowBox[{
          SubscriptBox["\[CapitalDelta]", "\[Pi]"], "->", "\[Delta]\[Pi]"}], 
         ",", 
         RowBox[{
          SubscriptBox["\[CapitalDelta]", "\[Sigma]"], "->", 
          "\[Delta]\[Sigma]"}]}], "}"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"evals", ",", "evecs"}], "}"}], "=", 
      RowBox[{"Eigensystem", "[", "Hdouble", "]"}]}], ";", "\n", 
     RowBox[{"UpUp", "=", 
      RowBox[{"evecs", "[", 
       RowBox[{"[", 
        RowBox[{
         RowBox[{"Ordering", "[", 
          RowBox[{
           RowBox[{"N", "[", "evals", "]"}], ",", 
           RowBox[{"-", "1"}]}], "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}]}], ";", 
     RowBox[{"(*", 
      RowBox[{
      "Take", " ", "eigenstate", " ", "with", " ", "the", " ", "highest", " ",
        "eigenvalue"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"UpUp", "=", 
      RowBox[{"UpUp", "/", 
       RowBox[{"Norm", "[", "UpUp", "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"d\[Sigma]", "=", 
      RowBox[{"2", "*", 
       RowBox[{"UpUp", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "*", 
       RowBox[{
        RowBox[{"UpUp", "[", 
         RowBox[{"[", "4", "]"}], "]"}], "/", 
        RowBox[{"Sqrt", "[", "12", "]"}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"d\[Pi]", "=", 
      RowBox[{"2", "*", 
       RowBox[{"UpUp", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "*", 
       RowBox[{
        RowBox[{"UpUp", "[", 
         RowBox[{"[", "3", "]"}], "]"}], "/", 
        RowBox[{"Sqrt", "[", "6", "]"}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Return", "[", 
      RowBox[{"2.72", "*", 
       RowBox[{"Sqrt", "[", 
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{"d\[Sigma]", "^", "2"}], " ", "-", " ", 
          RowBox[{"d\[Pi]", "^", "2"}]}], "]"}], "]"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.9567865040764933`*^9, 3.9567865542805233`*^9}, {
   3.956786595496998*^9, 3.956786803912766*^9}, {3.956786846307561*^9, 

          RowBox[{"[", "2", "]"}], "]"}], ",", 
         RowBox[{"\[Phi]Collision", "[", 
          RowBox[{"[", "2", "]"}], "]"}], ",", "\[Xi]MW"}], "]"}], "]"}], "-", 
      RowBox[{"CVdW6", "/", 
       RowBox[{"r", "^", "6"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
